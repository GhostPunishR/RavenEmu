<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:allowBackup="false"
        android:label="RavenEmu Native (Test)"
        android:theme="@style/RavenEmuNativeTheme"
        android:usesCleartextTraffic="false">
        <activity android:name=".ThirdPartyLicensesActivity" android:exported="false"/>
        <activity android:name=".NativeHomeActivity"
            android:exported="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Experimental JNI video player, launched from the Java RavenEmu-style
             library game-details sheet. It is not a second launcher. -->
        <activity android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="unspecified"/>
    </application>
</manifest>
