<?xml version="1.0" encoding="utf-8"?>
<!--
  Pastille d'état posée sur le coin d'une pochette. Elle ne s'affiche que
  lorsque la cartouche n'est pas intacte : signaler l'anomalie suffit, et
  décorer chaque jeu conforme d'une étiquette ne dirait rien de plus.

  La couleur est posée par le code, la forme seule est ici. Le liseré sombre
  détache la pastille d'une jaquette claire.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
    <stroke
        android:width="1dp"
        android:color="@color/raven_background" />
</shape>
