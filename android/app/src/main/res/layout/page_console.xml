<?xml version="1.0" encoding="utf-8"?>
<!--
  Une page de la bibliothèque : les jeux d'une console. Le message d'accueil
  vit dans la page, pas dans l'écran, afin d'être propre à la console affichée
  — « aucun jeu ici » et « aucun jeu du tout » ne se disent pas pareil.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/romList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@color/raven_text_muted"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
