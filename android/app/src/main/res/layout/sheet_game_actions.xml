<?xml version="1.0" encoding="utf-8"?><!--
  Actions d'un jeu, présentées en feuille venant du bas.

  La liste d'items d'une boîte de dialogue ne montrait que des libellés, sans
  dire de quel jeu il s'agissait ni distinguer l'action destructrice des
  autres. Ici l'en-tête rappelle le jeu et sa plateforme, et « retirer » est
  séparé du reste par un filet.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/raven_surface"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textColor="@color/raven_text_primary" />

    <TextView
        android:id="@+id/sheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/raven_text_secondary" />

    <TextView
        android:id="@+id/actionPlay"
        style="@style/RavenSheetAction"
        android:text="@string/library_action_play" />

    <TextView
        android:id="@+id/actionStates"
        style="@style/RavenSheetAction"
        android:text="@string/library_action_states" />

    <TextView
        android:id="@+id/actionRename"
        style="@style/RavenSheetAction"
        android:text="@string/library_action_rename" />

    <TextView
        android:id="@+id/actionCover"
        style="@style/RavenSheetAction"
        android:text="@string/library_choose_cover" />

    <TextView
        android:id="@+id/actionSaveType"
        style="@style/RavenSheetAction"
        android:text="@string/library_save_type" />

    <TextView
        android:id="@+id/actionDetails"
        style="@style/RavenSheetAction"
        android:text="@string/library_rom_details" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/raven_outline" />

    <TextView
        android:id="@+id/actionRemove"
        style="@style/RavenSheetAction"
        android:text="@string/library_action_remove"
        android:textColor="@color/badge_invalid_header" />
</LinearLayout>
