# Normalize the upstream C API at build time. The generated rename header is
# private to the SDK target; consumers see only the normalized public header.
function(ravenemu_neutral_bridge target upstream_header output_dir)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${upstream_header}")
    file(READ "${upstream_header}" header)
    string(REGEX MATCHALL "(ravenemu_v[0-9]+_|RAVENEMU_V[0-9]+_)[A-Za-z0-9_]+" names "${header}")
    list(REMOVE_DUPLICATES names)
    # Predefining a header guard would suppress the entire upstream header;
    # predefining its constants would produce macro redefinition warnings.
    string(REGEX MATCHALL "#[ \t]*define[ \t]+[A-Za-z0-9_]+" definitions "${header}")
    foreach(definition IN LISTS definitions)
        string(REGEX REPLACE "#[ \t]*define[ \t]+" "" name "${definition}")
        list(REMOVE_ITEM names "${name}")
    endforeach()
    set(renames "/* Generated from the pinned RavenCore C API. */\n")
    foreach(name IN LISTS names)
        string(REGEX REPLACE "ravenemu_v[0-9]+_" "ravenemu_" neutral "${name}")
        string(REGEX REPLACE "RAVENEMU_V[0-9]+_" "RAVENEMU_" neutral "${neutral}")
        string(APPEND renames "#define ${name} ${neutral}\n")
    endforeach()
    string(REGEX REPLACE "ravenemu_v[0-9]+_" "ravenemu_" header "${header}")
    string(REGEX REPLACE "RAVENEMU_V[0-9]+_" "RAVENEMU_" header "${header}")
    file(MAKE_DIRECTORY "${output_dir}/ravenemu")
    file(WRITE "${output_dir}/bridge-renames.h" "${renames}")
    file(WRITE "${output_dir}/ravenemu/bridge.h" "${header}")
    file(WRITE "${output_dir}/bridge.h" "${header}")
    target_compile_options(${target} PRIVATE "-include" "${output_dir}/bridge-renames.h")
    target_include_directories(${target} BEFORE INTERFACE "${output_dir}")
endfunction()
