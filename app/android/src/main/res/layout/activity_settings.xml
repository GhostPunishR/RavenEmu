<?xml version="1.0" encoding="utf-8"?>
<!--
  Un titre au-dessus de la liste, dans le style des autres écrans de
  l'application. Il compte plus qu'avant : la fenêtre est immersive et sans
  barre d'action, si bien qu'entré dans « Audio » ou « Vidéo » rien d'autre ne
  dirait où l'on se trouve.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:text="@string/settings_title"
        android:textAppearance="?attr/textAppearanceHeadline5" />

    <FrameLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
