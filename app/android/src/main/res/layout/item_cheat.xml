<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/cheatEnabled"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:padding="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/cheatItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/raven_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cheatItemCodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="3"
            android:textColor="@color/raven_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/cheatEdit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cheat_edit"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_edit"
        android:tint="@color/raven_text_primary" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/cheatDelete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cheat_delete"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="@color/raven_text_primary" />
</LinearLayout>
