<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RavenEmu" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/raven_primary</item>
        <item name="colorPrimaryVariant">@color/raven_primary_dark</item>
        <item name="colorOnPrimary">@color/raven_text_primary</item>
        <item name="colorSecondary">@color/raven_accent</item>
        <item name="colorSecondaryVariant">@color/raven_primary</item>
        <item name="colorOnSecondary">@color/raven_on_accent</item>
        <item name="colorSurface">@color/raven_surface</item>
        <item name="colorOnSurface">@color/raven_text_primary</item>
        <item name="colorOnBackground">@color/raven_text_primary</item>

        <item name="android:windowBackground">@color/raven_background</item>
        <item name="android:colorBackground">@color/raven_background</item>
        <item name="android:statusBarColor">@color/raven_primary_dark</item>
        <item name="android:navigationBarColor">@color/raven_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:textColorPrimary">@color/raven_text_primary</item>
        <item name="android:textColorSecondary">@color/raven_text_secondary</item>
        <item name="colorControlActivated">@color/raven_accent</item>
        <item name="colorControlNormal">@color/raven_text_secondary</item>
        <item name="colorControlHighlight">@color/raven_ripple</item>
    </style>

    <style name="Theme.RavenEmu.Fullscreen" parent="Theme.RavenEmu">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
